<Window x:Class="ClassroomKit.Agent.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:ClassroomKit.Agent.Desktop.Pages"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ClassroomKit"
        Width="1120" Height="760" MinWidth="960" MinHeight="640"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource AppBackground}"
        FontFamily="{DynamicResource AppFont}" Foreground="{DynamicResource TextPrimary}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        SnapsToDevicePixels="True" PreviewKeyDown="OnWindowPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ 标题栏：品牌 · 状态 · 窗口按钮 ============ -->
        <Grid Grid.Row="0" Background="{DynamicResource AppBackground}"
              MouseRightButtonUp="OnTitleBarRightButtonUp">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image x:Name="BrandIcon" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="ClassroomKit" FontSize="12.5" FontWeight="SemiBold" Margin="10,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource Success}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HealthStatus}" Value="warn">
                                    <Setter Property="Fill" Value="{DynamicResource Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HealthStatus}" Value="fail">
                                    <Setter Property="Fill" Value="{DynamicResource Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StateText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}" />
                <Border Width="1" Height="12" Background="{DynamicResource Stroke}" Margin="12,0" />
                <TextBlock Text="{Binding PauseText}" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Click="OnMinimizeClick"
                        ToolTip="最小化">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="OnMaximizeClick"
                        ToolTip="最大化">
                    <TextBlock x:Name="MaxGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource WindowCloseButton}" Click="OnCloseClick"
                        ToolTip="关闭">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ 主体：导航 + 内容 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0" Style="{StaticResource NavList}" Margin="0,8,0,0"
                             ItemsSource="{Binding PagesView}" SelectedValuePath="Key"
                             SelectedValue="{Binding PageKey, Mode=TwoWay}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextMuted}" Margin="22,12,0,4" />
                                                        <ItemsPresenter />
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Width="20" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding Title}" FontSize="13" Margin="2,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" Margin="12,6,12,14">
                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                HorizontalAlignment="Stretch" Height="34" Padding="10,0"
                                Visibility="{Binding OnboardingEntryVisible, Converter={StaticResource BoolVisibility}}"
                                Command="{Binding ContinueOnboardingCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OnboardingEntryText}" FontSize="12.5" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OnboardingStepText}" FontSize="12" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" Margin="10,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="36,26,36,0">
                <pages:OverviewPage Visibility="{Binding PageKey, Converter={StaticResource PageVisibility}, ConverterParameter=overview}" />
                <pages:HotspotPage Visibility="{Binding PageKey, Converter={StaticResource PageVisibility}, ConverterParameter=hotspot}" />
                <pages:LessonPage Visibility="{Binding PageKey, Converter={StaticResource PageVisibility}, ConverterParameter=lesson}" />
                <pages:UpdatePage Visibility="{Binding PageKey, Converter={StaticResource PageVisibility}, ConverterParameter=update}" />
                <pages:DiagnosePage Visibility="{Binding PageKey, Converter={StaticResource PageVisibility}, ConverterParameter=diagnose}" />
                <pages:AdvancedPage Visibility="{Binding PageKey, Converter={StaticResource PageVisibility}, ConverterParameter=advanced}" />
                <pages:SettingsPage Visibility="{Binding PageKey, Converter={StaticResource PageVisibility}, ConverterParameter=settings}" />
                <pages:AboutPage Visibility="{Binding PageKey, Converter={StaticResource PageVisibility}, ConverterParameter=about}" />

                <!-- Toast：右下 InfoBar，不遮内容 -->
                <Border x:Name="ToastHost" Width="380" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,0,24" Visibility="{Binding ToastVisible, Converter={StaticResource BoolVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource InfoBar}">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.16" />
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastError}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Top" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE946;" />
                                    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ToastError}" Value="True">
                                            <Setter Property="Text" Value="&#xE7BA;" />
                                            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding ToastText}" Style="{StaticResource Body}" FontSize="13" />
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Width="26" Height="26" Padding="0"
                                Margin="8,0,0,0" Command="{Binding DismissToastCommand}" ToolTip="关闭">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                        </Button>
                    </Grid>
                </Border>

                <!-- 教程引导：只盖内容区，不盖导航和标题栏；点空白/按 Esc 暂停 -->
                <Grid Background="{DynamicResource OverlayBackground}"
                      Visibility="{Binding ShowOnboarding, Converter={StaticResource BoolVisibility}}"
                      MouseLeftButtonDown="OnOnboardingBackdrop">
                    <Border Width="620" MaxWidth="620" Padding="28" CornerRadius="10"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}"
                            BorderThickness="1" MouseLeftButtonDown="OnOnboardingCard">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.22" />
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource AccentSoft}">
                                    <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="欢迎使用 ClassroomKit" Style="{StaticResource H1}" />
                                    <TextBlock Text="两分钟把这台机器配好；中途可以跳过，之后到「关于」页能再看。"
                                               Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <Border Style="{StaticResource InfoBar}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="课表由 ClassIsland 提供。ClassIsland 与 ClassroomKit 插件装不装、什么时候装都由你决定，这里只给出入口。"
                                               Style="{StaticResource Secondary}" Foreground="{DynamicResource TextPrimary}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="打开 ClassIsland 官网" Style="{StaticResource GhostButton}"
                                                Padding="0" Margin="0,0,16,0" Command="{Binding OpenClassIslandSiteCommand}" />
                                        <Button Content="打开 ClassroomKit 下载页" Style="{StaticResource GhostButton}"
                                                Padding="0" Command="{Binding OpenReleasesCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Divider}" Margin="0,18,0,14" />
                            <TextBlock Text="{Binding OnboardingStepText}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding OnboardingTitle}" Style="{StaticResource H2}" Margin="0,4,0,8" />
                            <TextBlock Text="{Binding OnboardingBody}" Style="{StaticResource Body}" />
                            <Button Content="{Binding OnboardingAction}" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left" Padding="0" Margin="0,12,0,0"
                                    Command="{Binding GoOnboardingPageCommand}" />

                            <Grid Margin="0,22,0,0">
                                <Button Content="上一步" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                        Command="{Binding PrevOnboardingCommand}"
                                        IsEnabled="{Binding OnboardingCanGoBack}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="先收起" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                            Command="{Binding PauseOnboardingCommand}" ToolTip="左下角「教程引导」能接着看" />
                                    <Button Content="跳过" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                            Command="{Binding SkipOnboardingCommand}" />
                                    <Button Content="{Binding OnboardingNextText}" Style="{StaticResource PrimaryButton}"
                                            MinWidth="88" Command="{Binding NextOnboardingCommand}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- 高级模式确认：窗口内 ContentDialog 风格，不再用系统 MessageBox -->
        <Grid x:Name="HabitConfirmOverlay" Grid.RowSpan="2" Panel.ZIndex="50"
              Background="{DynamicResource OverlayBackground}"
              Visibility="{Binding HabitConfirmVisible, Converter={StaticResource BoolVisibility}}">
            <Border Style="{StaticResource Card}" Width="460" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   Foreground="{DynamicResource Warning}" VerticalAlignment="Center" />
                        <TextBlock Text="开启习惯模式" Style="{StaticResource H2}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="强烈建议熟知老师习惯后再开启。" Style="{StaticResource Body}" Margin="0,14,0,0" />
                    <Border Style="{StaticResource InfoBar}" Margin="0,14,0,0">
                        <TextBlock Text="开启后，没有设置习惯软件的科目在冲突时将不做任何处理：既不弹窗，也不自动关闭任何软件。"
                                   Style="{StaticResource Body}" TextWrapping="Wrap" />
                    </Border>
                    <Grid Margin="0,22,0,0">
                        <Button x:Name="CancelHabitButton" Content="取消" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Command="{Binding CancelHabitModeCommand}" />
                        <Button Content="开启" Style="{StaticResource PrimaryButton}" MinWidth="88"
                                HorizontalAlignment="Right" Command="{Binding ConfirmHabitModeCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 热点连接卡：给全班看的大字 SSID/密码，120 秒后自动收起 -->
        <Grid x:Name="ConnectionCardOverlay" Grid.RowSpan="2" Panel.ZIndex="60"
              Background="{DynamicResource OverlayBackground}"
              Visibility="{Binding ConnectionCardVisible, Converter={StaticResource BoolVisibility}}">
            <Border Style="{StaticResource Card}" Width="560" Padding="32"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <TextBlock Text="连接教室热点" Style="{StaticResource H1}" HorizontalAlignment="Center" />
                    <TextBlock Text="手机 Wi-Fi 里选下面这个名字，再输入密码" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" Margin="0,6,0,22" />
                    <TextBlock Text="{Binding Ssid}" Style="{StaticResource Display}"
                               HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="密码" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,20,0,4" />
                    <TextBlock Text="{Binding Passphrase}" FontFamily="Consolas" FontSize="34" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <Border Style="{StaticResource InfoBar}" Margin="0,24,0,0">
                        <TextBlock Text="这张卡 2 分钟后自动收起；密码只在本机显示，不会上传。"
                                   Style="{StaticResource Body}" TextWrapping="Wrap" />
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <Button Content="复制密码" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CopyPasswordCommand}" />
                        <Button Content="关闭" Style="{StaticResource PrimaryButton}" MinWidth="96" Margin="10,0,0,0"
                                IsCancel="True" Command="{Binding CloseConnectionCardCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
