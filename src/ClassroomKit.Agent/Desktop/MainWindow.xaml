<Window x:Class="ClassroomKit.Agent.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:ClassroomKit.Agent.Desktop"
        xmlns:pages="clr-namespace:ClassroomKit.Agent.Desktop.Pages"
        Title="ClassroomKit · 教室一体机助手"
        Width="1120" Height="760" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource AppBackground}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 页面切换：淡入 + 轻微上移，七个页面实例常驻，状态不丢 -->
        <Style TargetType="{x:Type UserControl}">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="8" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard x:Name="PageFadeIn">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="PageFadeIn" />
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 标题栏（整条是拖动区，按钮单独放行） ===== -->
        <Grid Grid.Row="0" Background="{DynamicResource SidebarBackground}"
              MouseRightButtonUp="OnTitleBarRightButtonUp">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image x:Name="BrandIcon" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="ClassroomKit" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                <Border Width="1" Height="14" Margin="10,0" Background="{DynamicResource Stroke}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="{Binding PageSubtitle}" FontSize="10.5"
                               Foreground="{DynamicResource TextMuted}" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="OnMinimizeClick" ToolTip="最小化" />
                <Button x:Name="MaxButton" Style="{StaticResource WindowButton}" Content="&#xE922;"
                        Click="OnMaximizeClick" ToolTip="最大化" />
                <Button Style="{StaticResource WindowCloseButton}" Content="&#xE8BB;" Click="OnCloseClick" ToolTip="关闭" />
            </StackPanel>
        </Grid>

        <!-- ===== 主体 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧栏 -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Stroke}"
                            BorderThickness="0,1,0,0" Padding="20,14,20,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Success}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HealthStatus}" Value="warn">
                                                    <Setter Property="Fill" Value="{DynamicResource Warning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HealthStatus}" Value="fail">
                                                    <Setter Property="Fill" Value="{DynamicResource Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StateText}" Style="{StaticResource Secondary}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding PauseText}" Style="{StaticResource Caption}" Margin="16,3,0,0" />
                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                            <Button Content="打开网页面板" Style="{StaticResource GhostButton}"
                                    Command="{Binding OpenPanelCommand}" HorizontalAlignment="Left"
                                    Margin="-12,6,0,0" Padding="12,6" />
                        </StackPanel>
                    </Border>

                    <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding PagesView}"
                             SelectedValuePath="Key" SelectedValue="{Binding PageKey, Mode=TwoWay}"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled" Margin="0,16,0,8">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}"
                                                   Margin="24,10,24,6" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontSize="13" Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 内容 -->
            <Grid Grid.Column="1">
                <Grid Margin="32,22,32,0">
                    <pages:OverviewPage Visibility="{Binding PageKey, Converter={StaticResource PageVisibility}, ConverterParameter=overview}" />
                    <pages:HotspotPage Visibility="{Binding PageKey, Converter={StaticResource PageVisibility}, ConverterParameter=hotspot}" />
                    <pages:LessonPage Visibility="{Binding PageKey, Converter={StaticResource PageVisibility}, ConverterParameter=lesson}" />
                    <pages:UpdatePage Visibility="{Binding PageKey, Converter={StaticResource PageVisibility}, ConverterParameter=update}" />
                    <pages:DiagnosePage Visibility="{Binding PageKey, Converter={StaticResource PageVisibility}, ConverterParameter=diagnose}" />
                    <pages:AdvancedPage Visibility="{Binding PageKey, Converter={StaticResource PageVisibility}, ConverterParameter=advanced}" />
                    <pages:SettingsPage Visibility="{Binding PageKey, Converter={StaticResource PageVisibility}, ConverterParameter=settings}" />
                    <pages:AboutPage Visibility="{Binding PageKey, Converter={StaticResource PageVisibility}, ConverterParameter=about}" />
                </Grid>

                <!-- Toast：右下角卡片，错误时描边/底色转红 -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,24"
                        Width="360" CornerRadius="12" Padding="14,12"
                        Background="{DynamicResource ToastBackground}"
                        Visibility="{Binding ToastVisible, Converter={StaticResource BoolVisibility}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.16" Color="#000000" />
                    </Border.Effect>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastError}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
                                    <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="ToastGlyph" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{DynamicResource Success}" />
                        <TextBlock Grid.Column="1" Text="{Binding ToastText}" Style="{StaticResource Body}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                Style="{StaticResource WindowButton}" Width="26" Height="26" Margin="10,0,0,0"
                                Command="{Binding DismissToastCommand}" ToolTip="关闭" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 首次启动教程引导（0.7.0）：只有空白配置才会自动弹；完成/跳过写盘，之后可在设置里重开 -->
        <Grid Grid.RowSpan="2" Background="#B3000000"
              Visibility="{Binding ShowOnboarding, Converter={StaticResource BoolVisibility}}">
            <Border Style="{StaticResource Card}" Width="640" Padding="26"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="欢迎使用 ClassroomKit" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="先花两分钟把这台机器配好；中途可以跳过，之后到「设置 · 关于」能再看。"
                               Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="课表由 ClassIsland 提供，ClassroomKit 只负责在它旁边搭把手：装不装、什么时候装都由你决定，这里只给个入口。"
                               Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="打开 ClassIsland 官网" Style="{StaticResource GhostButton}"
                                Command="{Binding OpenClassIslandSiteCommand}" />
                        <Button Content="打开 ClassroomKit 下载页" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding OpenReleasesCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding OnboardingStepText}" Style="{StaticResource Caption}" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding OnboardingTitle}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding OnboardingBody}" Style="{StaticResource Secondary}" Margin="0,8,0,0"
                               TextWrapping="Wrap" LineHeight="22" />
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="{Binding OnboardingAction}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding GoOnboardingPageCommand}" />
                        <Button Content="上一步" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                IsEnabled="{Binding OnboardingCanGoBack}"
                                Command="{Binding PrevOnboardingCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Right">
                        <Button Content="跳过" Style="{StaticResource GhostButton}" Command="{Binding SkipOnboardingCommand}" />
                        <Button Content="{Binding OnboardingNextText}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding NextOnboardingCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
