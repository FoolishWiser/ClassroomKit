<Window x:Class="ClassroomKit.Agent.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClassroomKit.Agent.Desktop"
        xmlns:pages="clr-namespace:ClassroomKit.Agent.Desktop.Pages"
        Title="ClassroomKit · 教室一体机助手"
        Width="1120" Height="760" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,18">
                    <TextBlock Text="ClassroomKit" Style="{StaticResource H2}" />
                    <TextBlock Text="教室一体机助手" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Padding="16,14,16,16"
                        BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardBorder}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Success}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StateText}" Style="{StaticResource Secondary}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding PauseText}" Style="{StaticResource Caption}" Margin="16,4,0,0" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                        <Button Content="打开网页面板" Style="{StaticResource GhostButton}"
                                Command="{Binding OpenPanelCommand}" HorizontalAlignment="Left" Padding="0,6,0,0" />
                    </StackPanel>
                </Border>

                <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding Pages}"
                         SelectedValuePath="Key" SelectedValue="{Binding PageKey, Mode=TwoWay}"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding Title}" FontSize="13" Margin="12,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 内容 -->
        <Grid Grid.Column="1">
            <Grid Margin="26,22,26,0">
                <pages:OverviewPage Visibility="{Binding PageKey, Converter={StaticResource PageVisibility}, ConverterParameter=overview}" />
                <pages:HotspotPage Visibility="{Binding PageKey, Converter={StaticResource PageVisibility}, ConverterParameter=hotspot}" />
                <pages:LessonPage Visibility="{Binding PageKey, Converter={StaticResource PageVisibility}, ConverterParameter=lesson}" />
                <pages:UpdatePage Visibility="{Binding PageKey, Converter={StaticResource PageVisibility}, ConverterParameter=update}" />
                <pages:DiagnosePage Visibility="{Binding PageKey, Converter={StaticResource PageVisibility}, ConverterParameter=diagnose}" />
                <pages:SettingsPage Visibility="{Binding PageKey, Converter={StaticResource PageVisibility}, ConverterParameter=settings}" />
            </Grid>

            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                    Background="{DynamicResource ToastBackground}" BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1" CornerRadius="9" Padding="18,10"
                    Visibility="{Binding ToastVisible, Converter={StaticResource BoolVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ToastError}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ToastText}" Style="{StaticResource Body}" />
            </Border>
        </Grid>
    </Grid>
</Window>
