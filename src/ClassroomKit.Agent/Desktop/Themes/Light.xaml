<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色令牌：偏冷的纸白 + 低饱和描边，卡片靠 1px 描边分层，不用重阴影 -->
    <SolidColorBrush x:Key="AppBackground" Color="#F3F5F9" />
    <SolidColorBrush x:Key="SidebarBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F7F9FC" />
    <SolidColorBrush x:Key="Stroke" Color="#E4E8EF" />
    <SolidColorBrush x:Key="StrokeStrong" Color="#D3D9E3" />
    <SolidColorBrush x:Key="ControlBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBorder" Color="#D6DCE5" />
    <SolidColorBrush x:Key="TextPrimary" Color="#16181D" />
    <SolidColorBrush x:Key="TextSecondary" Color="#5A6270" />
    <SolidColorBrush x:Key="TextMuted" Color="#8A92A0" />
    <SolidColorBrush x:Key="Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentPressed" Color="#1E40AF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#E8EFFF" />
    <SolidColorBrush x:Key="Success" Color="#12855A" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#E3F5ED" />
    <SolidColorBrush x:Key="Warning" Color="#B4690E" />
    <SolidColorBrush x:Key="WarningSoft" Color="#FDF1E0" />
    <SolidColorBrush x:Key="Danger" Color="#C42B1C" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FDECEB" />
    <SolidColorBrush x:Key="ToastBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TooltipBackground" Color="#1F2430" />
    <SolidColorBrush x:Key="TooltipText" Color="#F5F7FA" />
</ResourceDictionary>
