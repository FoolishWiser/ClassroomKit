<UserControl x:Class="ClassroomKit.Agent.Desktop.Pages.BoardPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Foreground="{DynamicResource TextPrimary}" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,28">
            <StackPanel Style="{StaticResource PageHeader}">
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="保存板书" Style="{StaticResource H2}" />
                    <TextBlock Text="保存时按课表科目改名、按科目建文件夹，并写下这一次的节次。"
                               Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding BoardPreview}" Style="{StaticResource Mono}" FontSize="14"
                               Margin="0,12,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="立即保存板书" Style="{StaticResource PrimaryButton}" Command="{Binding SaveBoardNamedCommand}" />
                        <Button Content="预览自动保存倒计时" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding PreviewAutoSaveCommand}" />
                    </StackPanel>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <CheckBox Content="按课表科目改名" IsChecked="{Binding EditNameWithLesson}" />
                            <CheckBox Content="文件名里带上第几节" Margin="0,8,0,0" IsChecked="{Binding EditIncludeLessonInName}" />
                            <CheckBox Content="按科目建文件夹归档" Margin="0,8,0,0" IsChecked="{Binding EditSubjectFolders}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <CheckBox Content="保存后清屏" IsChecked="{Binding EditClearAfterSave}" />
                            <CheckBox Content="下一节同科目时提示续用" Margin="0,8,0,0" IsChecked="{Binding EditReusePrompt}" />

                        </StackPanel>
                    </Grid>
                    <TextBlock Text="命名模板" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                    <TextBox Style="{StaticResource Input}" Text="{Binding EditNameTemplate, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{}{科目}_{节次}_{日期}_{时间}" />
                    <TextBlock Text="占位符：{科目} {日期} {时间} {节次} {周几}。没写 {节次} 时，打开「文件名里带上第几节」会自动补上。"
                               Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <Button Content="保存板书设置" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"
                            HorizontalAlignment="Left" Command="{Binding SaveLessonCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsGroup}" Margin="0,16,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRow}" Padding="20,16" MinHeight="0" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="板书中心" Style="{StaticResource H2}" />
                                <TextBlock Text="{Binding BoardLibraryText}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding BoardFolderText}" Style="{StaticResource Mono}" FontSize="11.5"
                                           Opacity="0.55" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="打开目录" Style="{StaticResource SecondaryButton}" Command="{Binding OpenBoardFolderCommand}" />
                                <Button Content="刷新" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Command="{Binding RefreshBoardLibraryCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding BoardRecent}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SettingsRow}" BorderThickness="0" Padding="20,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding SubjectText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="最近保存的 5 个板书会列在这里；文件仍由 ClassInX 保存，本页只做索引。"
                               Style="{StaticResource Caption}" Margin="20,2,20,16" TextWrapping="Wrap"
                               Visibility="{Binding BoardRecentEmpty, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsGroup}" Margin="0,16,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRow}" Padding="20,16" MinHeight="0" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="保存历史" Style="{StaticResource H2}" />
                                <TextBlock Text="{Binding BoardArchiveText}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="刷新" Style="{StaticResource GhostButton}"
                                    VerticalAlignment="Center" Command="{Binding RefreshBoardLibraryCommand}" />
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding BoardHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SettingsRow}" BorderThickness="0" Padding="20,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Subject}" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding LessonText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayTime}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding FileCountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <Button Grid.Column="4" Content="打开" Style="{StaticResource GhostButton}" Padding="0"
                                                HorizontalAlignment="Right"
                                                Command="{Binding DataContext.OpenBoardRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsGroup}" Margin="0,16,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRow}" Padding="20,16" MinHeight="0" BorderThickness="0">
                        <StackPanel>
                            <TextBlock Text="续用与清屏" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding ReuseStatusText}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsRow}" BorderThickness="0" Padding="20,8,20,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="预览续用提示" Style="{StaticResource SecondaryButton}" Command="{Binding PreviewReuseCommand}" />
                                <TextBlock Text="清屏按键" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="16,0,8,0" />
                                <ComboBox Width="120" ItemsSource="{Binding ClearKeyOptions}" SelectedItem="{Binding EditClearKey}" />
                            </StackPanel>
                            <TextBlock Text="保存后先 Ctrl+A 全选，再按所选按键；前后画面指纹变化超过 2% 才算成功。"
                                       Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
