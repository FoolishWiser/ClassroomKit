<UserControl x:Class="ClassroomKit.Agent.Desktop.Pages.HotspotPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClassroomKit.Agent.Desktop.Controls"
        Foreground="{DynamicResource TextPrimary}" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,28">
            <StackPanel Style="{StaticResource PageHeader}">
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="热点状态" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Pill}" Margin="10,0,0,0">
                                <TextBlock Text="{Binding HotspotStateText}" Style="{StaticResource PillText}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Ssid}" Style="{StaticResource Display}" Margin="0,10,0,6" />
                        <TextBlock Text="{Binding Passphrase, StringFormat=密码：{0}}" Style="{StaticResource Mono}" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="在线 " Style="{StaticResource Secondary}" />
                            <TextBlock Text="{Binding ClientsText}" Style="{StaticResource H3}" />
                            <TextBlock Text="   ·   上行 " Style="{StaticResource Secondary}" />
                            <TextBlock Text="{Binding UplinkText}" Style="{StaticResource Secondary}" />
                            <TextBlock Text="   ·   设备上限 " Style="{StaticResource Secondary}" />
                            <TextBlock Text="{Binding MaxPeersText}" Style="{StaticResource Secondary}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                        <Button Content="投屏连接卡" Style="{StaticResource PrimaryButton}" MinWidth="150"
                                Command="{Binding ShowConnectionCardCommand}" />
                        <Button Content="复制热点密码" Style="{StaticResource SecondaryButton}" MinWidth="150" Margin="0,8,0,0"
                                Command="{Binding CopyPasswordCommand}" />
                        <Button Content="改用电脑名" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                Command="{Binding RenameToMachineCommand}" />
                        <Button Content="突破 8 台限制" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                Command="{Binding FixPeersCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsGroup}" Margin="0,16,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRow}" Padding="20,16" MinHeight="0" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="在线设备" Style="{StaticResource H2}" />
                                <TextBlock Text="连上热点的手机、平板会出现在这里；刚连上时可能晚几秒。"
                                           Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="刷新" Style="{StaticResource GhostButton}"
                                    VerticalAlignment="Center" Command="{Binding RefreshCommand}" />
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding HotspotClients}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SettingsRow}" BorderThickness="0" Padding="20,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Address}" Style="{StaticResource Mono}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Mac}" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding Duration}" Style="{StaticResource Caption}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="还没有设备连上热点。先在教室大屏上打开热点，再让学生连 Wi-Fi。"
                               Style="{StaticResource Caption}" Margin="20,4,20,18" TextWrapping="Wrap"
                               Visibility="{Binding HotspotClientsEmpty, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsGroup}" Margin="0,16,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRow}" Padding="20,16" MinHeight="0" BorderThickness="0">
                        <StackPanel>
                            <TextBlock Text="热点设置" Style="{StaticResource H2}" />
                            <TextBlock Text="改完点保存，下一轮巡检（约 15 秒内）生效，不需要重启。" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsRow}" BorderThickness="0" Padding="20,4,20,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="热点名（SSID）" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource Input}" Text="{Binding EditSsid, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="例如 CLASSROOM-302" />
                                <TextBlock Text="热点密码（至少 8 位）" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                                <TextBox Style="{StaticResource Input}" Text="{Binding EditPassphrase, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="留空表示不改" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="目标设备数" Style="{StaticResource FieldLabel}" />
                                <controls:NumericInput Value="{Binding EditTargetClients, Mode=TwoWay}" Minimum="1" Maximum="32" Suffix="台" />
                                <TextBlock Text="上限会写进注册表（默认 8 台），改成 16 以上才能容纳全班手机。"
                                           Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Content="保存设置" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding SaveHotspotCommand}" />
                                    <Button Content="刷新状态" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding RefreshCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
