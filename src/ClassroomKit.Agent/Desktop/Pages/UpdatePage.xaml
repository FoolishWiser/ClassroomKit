<UserControl x:Class="ClassroomKit.Agent.Desktop.Pages.UpdatePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClassroomKit.Agent.Desktop.Controls"
        Foreground="{DynamicResource TextPrimary}"
        Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,28">
            <Border Style="{StaticResource Card}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="当前版本" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Pill}" Margin="10,0,0,0" Padding="8,2">
                                <TextBlock Text="{Binding UpdatePhaseText}" Style="{StaticResource PillText}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding UpdateCurrentText}" Style="{StaticResource Display}" Margin="0,8,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="最新版本 " Style="{StaticResource Secondary}" />
                            <TextBlock Text="{Binding UpdateLatestText}" Style="{StaticResource Secondary}" FontWeight="SemiBold" />
                        </StackPanel>
                        <ProgressBar Margin="0,16,0,0" Maximum="1" Value="{Binding UpdateProgress, Mode=OneWay}" Height="6" />
                        <TextBlock Text="{Binding UpdateError}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   Foreground="{DynamicResource Danger}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                        <Button Content="检查更新" Style="{StaticResource SecondaryButton}" MinWidth="140"
                                Command="{Binding CheckUpdateCommand}" />
                        <Button Content="立即下载并安装" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"
                                Command="{Binding UpgradeCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="本版说明" Style="{StaticResource H2}" />
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <TextBlock Text="{Binding UpdateNotes}" Style="{StaticResource Secondary}" TextWrapping="Wrap" LineHeight="20" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ClassIsland 插件" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding UpdatePluginText}" Style="{StaticResource Secondary}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding UpdatePluginError}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="立即更新插件" Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Center" Command="{Binding UpdatePluginCommand}" />
                    </Grid>
                    <ProgressBar Margin="0,14,0,0" Maximum="1" Value="{Binding UpdatePluginProgress, Mode=OneWay}" Height="5" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="自动升级" Style="{StaticResource H2}" />
                    <TextBlock Text="护航任务在后台检查并安装，装完不会打断上课；没有设备连着热点时才动手。" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <CheckBox Content="自动下载并安装新版本（静默）" Margin="0,16,0,0" IsChecked="{Binding EditAutoInstall}" />
                    <CheckBox Content="开机后检查一次更新" Margin="0,10,0,0" IsChecked="{Binding EditCheckOnBoot}" />
                    <CheckBox Content="升级时同步更新 ClassIsland 插件" Margin="0,10,0,0" IsChecked="{Binding EditUpdatePlugin}" />
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" MaxWidth="360" HorizontalAlignment="Left">
                            <TextBlock Text="安装时间窗（留空 = 全天）" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Input}" Text="{Binding EditInstallWindow, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="例如 22:00-06:00；留空表示不限时间" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="保存升级设置" Style="{StaticResource PrimaryButton}"
                                VerticalAlignment="Bottom" Command="{Binding SaveUpdateCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
