<UserControl x:Class="ClassroomKit.Agent.Desktop.Pages.LessonPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClassroomKit.Agent.Desktop.Controls"
        Foreground="{DynamicResource TextPrimary}"
        Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,28">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="课表" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Pill}" Margin="10,0,0,0" Padding="8,2">
                                <TextBlock Text="{Binding LessonStateText}" Style="{StaticResource PillText}" />
                            </Border>
                        </StackPanel>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardSoft}" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="当前" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding LessonCurrentText}" Style="{StaticResource H2}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardSoft}" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="下一节" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding LessonNextText}" Style="{StaticResource H2}" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding LessonCountdownText}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="保存板书用的科目" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                        <TextBlock Text="{Binding LessonNameHint}" Style="{StaticResource H3}" />
                        <Border Style="{StaticResource CardSoft}" Margin="0,16,0,0" Padding="14">
                            <StackPanel>
                                <TextBlock Text="文件名预览" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding BoardPreview}" Style="{StaticResource Mono}" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="保存板书（按课表改名）" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveBoardNamedCommand}" />
                            <Button Content="预览课前提醒" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding PreviewReminderCommand}" />
                        </StackPanel>
                        <Button Content="清除课表数据，等插件重新推送" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding ClearLessonCommand}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="课前提醒" Style="{StaticResource H2}" />
                        <TextBlock Text="下一节到点前弹出提醒窗，提示保存 ClassInX 板书。" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        <CheckBox Content="启用课前提醒" Margin="0,16,0,0" IsChecked="{Binding EditLessonEnabled}" />
                        <CheckBox Content="只在 ClassInX 运行时提醒" Margin="0,10,0,0" IsChecked="{Binding EditOnlyWhenClassInBoard}" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="提前" Style="{StaticResource FieldLabel}" />
                                <controls:NumericInput Value="{Binding EditRemindMinutes, Mode=TwoWay}" Minimum="1" Maximum="30" Suffix="分钟" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="弹窗停留" Style="{StaticResource FieldLabel}" />
                                <controls:NumericInput Value="{Binding EditDialogSeconds, Mode=TwoWay}" Minimum="5" Maximum="600" Suffix="秒" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="倒计时结束后的动作" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                        <ComboBox ItemsSource="{Binding TimeoutOptions}" SelectedValue="{Binding EditTimeoutAction}"
                                  SelectedValuePath="Value" DisplayMemberPath="Label" />

                        <TextBlock Text="稍后提醒间隔" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                        <controls:NumericInput Value="{Binding EditSnoozeMinutes, Mode=TwoWay}" Minimum="1" Maximum="60" Suffix="分钟" />

                        <Button Content="保存课前提醒设置" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0"
                                HorizontalAlignment="Left" Command="{Binding SaveLessonCommand}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="板书命名" Style="{StaticResource H2}" />
                    <TextBlock Text="保存板书时按上一节课的科目改名，例如 数学_2026-11-14_10-05。占位符：{科目} {日期} {时间} {节次} {周几}。" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="命名模板" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Input}" Text="{Binding EditNameTemplate, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="{}{科目}_{日期}_{时间}" />
                            <CheckBox Content="保存时按课表改名（关掉则保留 ClassInX 原名）" Margin="0,14,0,0" IsChecked="{Binding EditNameWithLesson}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="保存命名设置" Style="{StaticResource PrimaryButton}"
                                VerticalAlignment="Bottom" Command="{Binding SaveLessonCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
