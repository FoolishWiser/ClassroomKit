<UserControl x:Class="ClassroomKit.Agent.Desktop.Pages.LessonPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClassroomKit.Agent.Desktop.Controls"
        Foreground="{DynamicResource TextPrimary}" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,28">
            <StackPanel Style="{StaticResource PageHeader}">
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="课表" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Pill}" Margin="10,0,0,0">
                                <TextBlock Text="{Binding LessonStateText}" Style="{StaticResource PillText}" />
                            </Border>
                        </StackPanel>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardSoft}" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="当前" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding LessonCurrentText}" Style="{StaticResource H2}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardSoft}" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="下一节" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding LessonNextText}" Style="{StaticResource H2}" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding LessonCountdownText}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="保存板书用的科目" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                        <TextBlock Text="{Binding LessonNameHint}" Style="{StaticResource H3}" />
                        <Border Style="{StaticResource CardSoft}" Margin="0,16,0,0" Padding="14">
                            <StackPanel>
                                <TextBlock Text="文件名预览" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding BoardPreview}" Style="{StaticResource Mono}" FontSize="14"
                                           Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="保存板书（按课表改名）" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveBoardNamedCommand}" />
                            <Button Content="预览课后提醒" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding PreviewReminderCommand}" />
                        </StackPanel>
                        <Button Content="清除课表数据，等插件重新推送" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding ClearLessonCommand}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="课后保存板书" Style="{StaticResource H2}" />
                        <TextBlock Text="下课后弹出提醒窗；连堂在最后一节下课后才提醒，可按课间名跳过。"
                                   Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <CheckBox Content="启用课后保存提醒" Margin="0,16,0,0" IsChecked="{Binding EditLessonEnabled}" />
                        <CheckBox Content="只在 ClassInX 运行时提醒" Margin="0,10,0,0" IsChecked="{Binding EditOnlyWhenClassInBoard}" />
                        <TextBlock Text="弹窗停留" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                        <controls:NumericInput Value="{Binding EditDialogSeconds, Mode=TwoWay}" Minimum="5" Maximum="600" Suffix="秒" />
                        <TextBlock Text="不在这些课间保存" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                        <TextBox Style="{StaticResource Input}" Text="{Binding EditSkipBreakNames, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" VerticalContentAlignment="Top"
                                 Tag="每行一个课间名，例如 高一礼让、跑操（留空 = 所有课间都保存）" />
                        <TextBlock Text="课间名取自 ClassIsland 时间点的自定义课间名，忽略大小写。"
                                   Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="倒计时结束后的动作" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                        <ComboBox ItemsSource="{Binding TimeoutOptions}" SelectedValue="{Binding EditTimeoutAction}" SelectedValuePath="Value">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextPrimary}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="稍后提醒间隔" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                        <controls:NumericInput Value="{Binding EditSnoozeMinutes, Mode=TwoWay}" Minimum="1" Maximum="60" Suffix="分钟" />
                        <Button Content="保存课后提醒设置" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0"
                                HorizontalAlignment="Left" Command="{Binding SaveLessonCommand}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource SettingsGroup}" Margin="0,16,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRow}" Padding="20,16" MinHeight="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="生效科目" Style="{StaticResource H2}" />
                                <TextBlock Text="{Binding SubjectHint}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="清空勾选" Style="{StaticResource GhostButton}"
                                    VerticalAlignment="Center" Command="{Binding ClearSubjectSelectionCommand}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsRow}" BorderThickness="0" Padding="20,8,20,20">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding SubjectOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource SubjectChip}" Content="{Binding Name}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="候选科目来自 ClassIsland 课表、配置和手动添加。不勾选任何一项 = 所有科目都提醒；保存后下一节课生效。"
                                       Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBox Style="{StaticResource Input}" Width="220" Text="{Binding NewSubjectText, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="手动添加科目名，例如 物理" />
                                <Button Content="添加科目" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                        Command="{Binding AddSubjectCommand}" />
                                <Button Content="保存科目设置" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                        Command="{Binding SaveLessonCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsGroup}" Margin="0,16,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRow}" Padding="20,16" MinHeight="0">
                        <StackPanel>
                            <TextBlock Text="板书命名" Style="{StaticResource H2}" />
                            <TextBlock Text="保存板书时按上一节课的科目改名，例如 数学_2026-11-14_10-05。占位符：{科目} {日期} {时间} {节次} {周几}。"
                                       Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsRow}" BorderThickness="0" Padding="20,8,20,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="命名模板" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource Input}" Text="{Binding EditNameTemplate, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="{}{科目}_{日期}_{时间}" />
                                <CheckBox Content="保存时按课表改名（关掉则保留 ClassInX 原名）" Margin="0,14,0,0" IsChecked="{Binding EditNameWithLesson}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="保存命名设置" Style="{StaticResource PrimaryButton}"
                                    VerticalAlignment="Bottom" Command="{Binding SaveLessonCommand}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
