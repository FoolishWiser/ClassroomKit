<UserControl x:Class="ClassroomKit.Agent.Desktop.Pages.LabPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Foreground="{DynamicResource TextPrimary}" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,28">
            <StackPanel Style="{StaticResource PageHeader}">
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="维词自动领读" Style="{StaticResource H2}" />
                        <Border Style="{StaticResource Pill}" Margin="10,0,0,0">
                            <TextBlock Text="实验性" Style="{StaticResource PillText}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="复用 weici-autoread 的页面脚本：找到维克多词表，按首词和尾词勾选，再按发音与循环次数开始。账号密码仍由维词自己保存，ClassroomKit 不读取。"
                               Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="首词" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Input}" Margin="0,6,0,0"
                                     Text="{Binding EditWeiciFirstWord, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="尾词（留空 = 只领首词这一个）" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Input}" Margin="0,6,0,0"
                                     Text="{Binding EditWeiciLastWord, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="发音" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource Input}" Margin="0,6,0,0"
                                      ItemsSource="{Binding WeiciPronOptions}"
                                      SelectedItem="{Binding EditWeiciPron, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="循环" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource Input}" Margin="0,6,0,0"
                                      ItemsSource="{Binding WeiciLoopOptions}"
                                      SelectedItem="{Binding EditWeiciLoop, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="试运行" Style="{StaticResource FieldLabel}" />
                            <CheckBox Content="只走到设置页，不点开始" Margin="0,10,0,0"
                                      IsChecked="{Binding EditWeiciDryRun}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="维词主程序" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditWeiciAppPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="调试端口" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Input}" Margin="0,6,0,0"
                                     Text="{Binding EditWeiciPort, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Bottom"
                                   TextWrapping="Wrap"
                                   Text="维词已经在运行时必须先完全退出，再点「开始」让 ClassroomKit 用调试端口重新拉起；否则会提示 NEED_DEBUG_PORT。" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="开始自动领读" Style="{StaticResource PrimaryButton}" Command="{Binding RunWeiciCommand}" />
                        <Button Content="取消" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding CancelWeiciCommand}" />
                        <Button Content="只保存参数" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding SaveWeiciCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsGroup}" Margin="0,16,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRow}" Padding="20,16" MinHeight="0">
                        <StackPanel>
                            <TextBlock Text="运行日志" Style="{StaticResource H2}" />
                            <TextBlock Text="保留最近一次运行的输出；失败时会给出 weici-autoread 的错误码。"
                                       Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBox Style="{StaticResource Input}" Margin="20,0,20,20" MinHeight="220"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding WeiciLog, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
