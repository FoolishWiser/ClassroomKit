<UserControl x:Class="ClassroomKit.Agent.Desktop.Pages.OverviewPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Foreground="{DynamicResource TextPrimary}" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,28">
            <StackPanel Style="{StaticResource PageHeader}">
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- 热点头卡：一眼看到当前 SSID 与在线设备 -->
            <Border Style="{StaticResource Card}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="教室热点" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Pill}" Margin="10,0,0,0">
                                <TextBlock Text="{Binding HotspotStateText}" Style="{StaticResource PillText}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Ssid}" Style="{StaticResource Display}" Margin="0,10,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="在线 " Style="{StaticResource Secondary}" />
                            <TextBlock Text="{Binding ClientsText}" Style="{StaticResource H3}" />
                            <TextBlock Text="   ·   上行 " Style="{StaticResource Secondary}" />
                            <TextBlock Text="{Binding UplinkText}" Style="{StaticResource Secondary}" />
                            <TextBlock Text="   ·   上限 " Style="{StaticResource Secondary}" />
                            <TextBlock Text="{Binding MaxPeersText}" Style="{StaticResource Secondary}" />
                        </StackPanel>
                        <TextBlock Text="{Binding PauseText}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                        <Button Content="开启 / 关闭热点" Style="{StaticResource PrimaryButton}" MinWidth="150"
                                Command="{Binding ToggleHotspotCommand}" />
                        <Button Content="暂停守护 30 分钟" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"
                                Command="{Binding PauseCommand}" />
                        <Button Content="立即刷新" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="下一节课" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding LessonNextText}" Style="{StaticResource H1}" Margin="0,8,0,2" />
                        <TextBlock Text="{Binding LessonCountdownText}" Style="{StaticResource Secondary}" />
                        <TextBlock Text="{Binding LessonStateText}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding LessonCurrentText, StringFormat=当前：{0}}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="保存板书" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding SaveBoardNamedCommand}" />
                            <Button Content="预览自动保存" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Command="{Binding PreviewAutoSaveCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="升级" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding UpdatePhaseText}" Style="{StaticResource H2}" Margin="0,8,0,2" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Mono}" />
                        <TextBlock Text="{Binding UpdateLatestText, StringFormat=最新：{0}}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="检查更新" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CheckUpdateCommand}" />
                            <Button Content="立即升级" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Command="{Binding UpgradeCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="GitHub 访问加速" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding HostsCountText}" Style="{StaticResource H2}" Margin="0,8,0,4" />
                        <TextBlock Text="{Binding HostsText}" Style="{StaticResource Secondary}" MaxHeight="42" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="刷新加速记录" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RefreshHostsCommand}" />
                            <Button Content="还原 hosts" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Command="{Binding RestoreHostsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="系统护航任务" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding HostsServiceText}" Style="{StaticResource Body}" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="安装护航任务" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding InstallServiceCommand}"
                                    Visibility="{Binding ServiceMissing, Converter={StaticResource BoolVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
