<UserControl x:Class="ClassroomKit.Agent.Desktop.Pages.OverviewPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="概览" Style="{StaticResource H1}" />
            <TextBlock Text="热点、课表、板书与升级，一眼看完" Style="{StaticResource Secondary}" Margin="0,4,0,20" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="教室热点" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding Ssid}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,4"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="在线 " Style="{StaticResource Secondary}" />
                            <TextBlock Text="{Binding ClientsText}" Style="{StaticResource Secondary}" FontWeight="SemiBold" />
                            <TextBlock Text="　" />
                            <TextBlock Text="上行 " Style="{StaticResource Secondary}" />
                            <TextBlock Text="{Binding UplinkText}" Style="{StaticResource Secondary}" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="开启 / 关闭热点" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ToggleHotspotCommand}" MinWidth="140" />
                        <Button Content="立即刷新" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="下一节课" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding LessonNextText}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,2"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{Binding LessonCountdownText}" Style="{StaticResource Secondary}" />
                        <TextBlock Text="{Binding LessonStateText}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        <Button Content="保存板书" Style="{StaticResource SecondaryButton}" Margin="0,14,0,0"
                                HorizontalAlignment="Left" Command="{Binding SaveBoardNamedCommand}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="升级" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding UpdatePhaseText}" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,2"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Style="{StaticResource Secondary}">
                            <Run Text="当前 " /><Run Text="{Binding VersionText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding UpdateLatestText}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        <Button Content="检查更新" Style="{StaticResource SecondaryButton}" Margin="0,14,0,0"
                                HorizontalAlignment="Left" Command="{Binding CheckUpdateCommand}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="GitHub 访问加速" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding HostsText}" Style="{StaticResource Body}" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="刷新 hosts" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshHostsCommand}" />
                        <Button Content="还原 hosts" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding RestoreHostsCommand}" />
                        <Button Content="安装护航任务" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding InstallServiceCommand}"
                                Visibility="{Binding ServiceMissing, Converter={StaticResource BoolVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
