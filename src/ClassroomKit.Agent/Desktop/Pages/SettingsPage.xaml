<UserControl x:Class="ClassroomKit.Agent.Desktop.Pages.SettingsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="设置" Style="{StaticResource H1}" />
            <TextBlock Text="界面、托盘行为与网络加速" Style="{StaticResource Secondary}" Margin="0,4,0,20" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="界面" Style="{StaticResource H2}" Margin="0,0,0,12" />
                    <CheckBox Content="关闭窗口时收进托盘（不退出）" IsChecked="{Binding EditCloseToTray}" Foreground="{DynamicResource TextPrimary}" />
                    <CheckBox Content="启动时只驻留托盘，不弹出主界面" IsChecked="{Binding EditStartMinimized}" Margin="0,8,0,0"
                              Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="主题" Style="{StaticResource Caption}" Margin="0,14,0,0" />
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding EditTheme}" Width="160" HorizontalAlignment="Left" Margin="0,6,0,0" />
                    <Button Content="保存界面设置" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" HorizontalAlignment="Left"
                            Command="{Binding SaveUiCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="GitHub 访问加速与护航任务" Style="{StaticResource H2}" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding HostsText}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="刷新 hosts" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshHostsCommand}" />
                        <Button Content="还原 hosts" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding RestoreHostsCommand}" />
                        <Button Content="安装护航任务" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding InstallServiceCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="关于" Style="{StaticResource H2}" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource Secondary}">
                        <Run Text="ClassroomKit · 教室一体机助手 " /><Run Text="{Binding VersionText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="配置与日志在 %ProgramData%\ClassroomKit" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="打开网页面板" Style="{StaticResource SecondaryButton}" Command="{Binding OpenPanelCommand}" />
                        <Button Content="打开日志目录" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding OpenLogsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
