<UserControl x:Class="ClassroomKit.Agent.Desktop.Pages.SettingsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Foreground="{DynamicResource TextPrimary}" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,28">
            <StackPanel Style="{StaticResource PageHeader}">
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>

            <Border Style="{StaticResource SettingsGroup}">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRow}" MinHeight="0" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="界面" Style="{StaticResource H2}" />
                            <TextBlock Text="窗口关闭、启动方式与外观主题。" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsRow}" Padding="20,8,20,12">
                        <CheckBox Content="关闭主界面时收进托盘，程序继续运行" IsChecked="{Binding EditCloseToTray}" />
                    </Border>
                    <Border Style="{StaticResource SettingsRow}" Padding="20,8,20,12">
                        <CheckBox Content="启动时只驻留托盘，不弹出主界面" IsChecked="{Binding EditStartMinimized}" />
                    </Border>
                    <Border Style="{StaticResource SettingsRow}" BorderThickness="0" Padding="20,8,20,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Width="220">
                                <TextBlock Text="外观主题" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedValue="{Binding EditTheme}" SelectedValuePath="Value">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextPrimary}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <Button Grid.Column="2" Content="保存界面设置" Style="{StaticResource PrimaryButton}"
                                    VerticalAlignment="Bottom" Command="{Binding SaveUiCommand}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsGroup}" Margin="0,16,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsRow}" MinHeight="0" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="托盘菜单" Style="{StaticResource H2}" />
                            <TextBlock Text="「保存并关闭 ClassInX」始终保留，其余动作默认收起，按需要打开。"
                                       Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsRow}" Padding="20,8,20,12">
                        <CheckBox Content="保存，保留 ClassInX" IsChecked="{Binding EditTraySaveKeepOpen}" />
                    </Border>
                    <Border Style="{StaticResource SettingsRow}" Padding="20,8,20,12">
                        <CheckBox Content="保存（不按课表改名）" IsChecked="{Binding EditTraySaveWithoutRename}" />
                    </Border>
                    <Border Style="{StaticResource SettingsRow}" Padding="20,8,20,12">
                        <CheckBox Content="预览课后提醒窗" IsChecked="{Binding EditTrayShowPreviewReminder}" />
                    </Border>
                    <Border Style="{StaticResource SettingsRow}" BorderThickness="0" Padding="20,8,20,20">
                        <Button Content="保存托盘菜单" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Command="{Binding SaveTrayCommand}" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ClassIsland 插件" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding UpdatePluginText}" Style="{StaticResource Secondary}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding UpdatePluginError}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="去升级页" Style="{StaticResource SecondaryButton}"
                            VerticalAlignment="Center" Margin="16,0,0,0" Command="{Binding OpenUpdatePageCommand}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="加速与护航" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding HostsServiceText}" Style="{StaticResource Secondary}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding HostsCountText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="安装护航任务" Style="{StaticResource PrimaryButton}"
                                Command="{Binding InstallServiceCommand}"
                                Visibility="{Binding ServiceMissing, Converter={StaticResource BoolVisibility}}" />
                        <Button Content="刷新加速记录" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding RefreshHostsCommand}" />
                        <Button Content="还原 hosts" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding RestoreHostsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
