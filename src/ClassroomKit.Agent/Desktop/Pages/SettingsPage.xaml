<UserControl x:Class="ClassroomKit.Agent.Desktop.Pages.SettingsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClassroomKit.Agent.Desktop.Controls"
        Foreground="{DynamicResource TextPrimary}"
        Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,28" MaxWidth="900" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="界面" Style="{StaticResource H2}" />
                    <CheckBox Content="关闭主界面时收进托盘，程序继续运行" Margin="0,16,0,0" IsChecked="{Binding EditCloseToTray}" />
                    <CheckBox Content="启动时只驻留托盘，不弹出主界面" Margin="0,10,0,0" IsChecked="{Binding EditStartMinimized}" />
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Width="200">
                            <TextBlock Text="外观主题" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedValue="{Binding EditTheme}"
                                      SelectedValuePath="Value">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextPrimary}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <Button Grid.Column="2" Content="保存界面设置" Style="{StaticResource PrimaryButton}"
                                VerticalAlignment="Bottom" Command="{Binding SaveUiCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="托盘菜单" Style="{StaticResource H2}" />
                    <TextBlock Text="「保存并关闭 ClassInX」始终保留，其余动作默认收起，按需要打开。" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <CheckBox Content="保存，保留 ClassInX" Margin="0,16,0,0" IsChecked="{Binding EditTraySaveKeepOpen}" />
                    <CheckBox Content="保存（不按课表改名）" Margin="0,10,0,0" IsChecked="{Binding EditTraySaveWithoutRename}" />
                    <CheckBox Content="预览课前提醒窗" Margin="0,10,0,0" IsChecked="{Binding EditTrayShowPreviewReminder}" />
                    <Button Content="保存托盘菜单" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"
                            HorizontalAlignment="Left" Command="{Binding SaveTrayCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="ClassIsland 插件" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding UpdatePluginText}" Style="{StaticResource Secondary}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding UpdatePluginError}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
                    <Button Content="立即更新插件" Style="{StaticResource SecondaryButton}" Margin="0,14,0,0"
                            HorizontalAlignment="Left" Command="{Binding UpdatePluginCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="加速与护航" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding HostsServiceText}" Style="{StaticResource Secondary}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding HostsCountText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="安装护航任务" Style="{StaticResource PrimaryButton}"
                                Command="{Binding InstallServiceCommand}"
                                Visibility="{Binding ServiceMissing, Converter={StaticResource BoolVisibility}}" />
                        <Button Content="刷新加速记录" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding RefreshHostsCommand}" />
                        <Button Content="还原 hosts" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding RestoreHostsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="关于" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Mono}" Margin="0,8,0,0" />
                    <TextBlock Text="ClassroomKit · 教室一体机助手。网页面板仍在运行，适合用手机打开；桌面端是本地主界面，两者共享同一份配置。" Style="{StaticResource Secondary}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="打开网页面板" Style="{StaticResource SecondaryButton}" Command="{Binding OpenPanelCommand}" />
                        <Button Content="打开日志目录" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding OpenLogsCommand}" />
                        <Button Content="检查更新" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding CheckUpdateCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
