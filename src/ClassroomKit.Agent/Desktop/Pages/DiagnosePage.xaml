<UserControl x:Class="ClassroomKit.Agent.Desktop.Pages.DiagnosePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Foreground="{DynamicResource TextPrimary}" Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource PageHeader}">
            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}" />
            <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DiagnoseSummary}" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding DiagnoseMeta}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="开始自检" Style="{StaticResource PrimaryButton}" Command="{Binding DiagnoseCommand}" />
                    <Button Content="打开日志目录" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Command="{Binding OpenLogsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
            <Border Style="{StaticResource CardTight}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,6">
                    <ItemsControl ItemsSource="{Binding DiagnoseRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Margin="0,6,10,0" VerticalAlignment="Top">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource Success}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="warn">
                                                            <Setter Property="Fill" Value="{DynamicResource Warning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="fail">
                                                            <Setter Property="Fill" Value="{DynamicResource Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" />
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="8,1,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding Next}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                        Visibility="{Binding DiagnoseEmpty, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="还没有自检结果" Style="{StaticResource H2}" HorizontalAlignment="Center" />
                <TextBlock Text="点上面的「开始自检」，十几项检查会列在这里。" Style="{StaticResource Caption}"
                           Margin="0,6,0,0" HorizontalAlignment="Center" />
            </StackPanel>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource CardTight}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,12,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="运行日志" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <CheckBox Content="跟随" IsChecked="{Binding LogFollow}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox Width="118" ItemsSource="{Binding LogLevelOptions}" SelectedValue="{Binding LogMinLevel}" SelectedValuePath="Value">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextPrimary}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0">
                        <ListBox x:Name="LogList" ItemsSource="{Binding LogEntries}" Style="{StaticResource PlainList}"
                                 Background="Transparent" BorderThickness="0" Padding="10,6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource Mono}"
                                                   Foreground="{DynamicResource TextMuted}" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding LevelText}" Margin="0,0,8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWarn}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDebug}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource Mono}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
