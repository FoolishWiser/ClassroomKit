<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <AssemblyName>ClassroomKit.Agent</AssemblyName>
    <RootNamespace>ClassroomKit.Agent</RootNamespace>
    <Product>ClassroomKit</Product>
    <Company>ClassroomKit</Company>
    <Description>教室一体机热点守护</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- 图标：ICO 只给发版用，Linux 上编译时不参与（交叉构建会因 Win32 资源报错） -->
    <ApplicationIcon Condition="'$(OS)' == 'Windows_NT'">Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClassroomKit.Core\ClassroomKit.Core.csproj" />
  </ItemGroup>

  <!-- 一体机常年开机：让 GC 尽量少占地，代价是极少量额外 CPU -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app-64.png" />
    <!-- 0.8.1：鸿蒙字体随包内嵌（WPF Resource），不安装到系统；许可随 dist 一起分发 -->
    <Resource Include="Assets\Fonts\HarmonyOS_SansSC_Regular.ttf" />
    <Resource Include="Assets\Fonts\HarmonyOS_SansSC_Semibold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Fonts\LICENSE-HarmonyOS-Sans.txt" Link="licenses\HarmonyOS-Sans-LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="licenses\THIRD-PARTY-NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\web\**\*">
      <Link>web\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>