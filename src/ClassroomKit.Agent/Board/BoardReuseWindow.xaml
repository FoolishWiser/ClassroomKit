<Window x:Class="ClassroomKit.Agent.Board.BoardReuseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="续用板书"
        Width="560" Height="240"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen">
    <Border Background="#FF101828" CornerRadius="16" Padding="28" BorderBrush="#FF2E90FA" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="发现上一节同科目板书" Foreground="#FF84CAFF" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" x:Name="MessageText" TextWrapping="Wrap" Foreground="White"
                       FontSize="20" LineHeight="32" Margin="0,14,0,16" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DismissButton" Content="这次不用" Padding="16,8" Margin="0,0,10,0" Click="OnDismiss" />
                <Button x:Name="SnoozeButton" Content="稍后（10 分钟）" Padding="16,8" Margin="0,0,10,0" Click="OnSnooze" />
                <Button x:Name="ReuseButton" Content="续用这份板书" Padding="18,8" Background="#FF2E90FA" Foreground="White" Click="OnReuse" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
