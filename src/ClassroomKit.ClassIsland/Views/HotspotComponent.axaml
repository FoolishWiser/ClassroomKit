<ci:ComponentBase
    x:Class="ClassroomKit.ClassIsland.Views.HotspotComponent"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ci="http://classisland.tech/schemas/xaml/core">
    <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock x:Name="Headline" Text="热点" FontWeight="SemiBold" />
        <TextBlock x:Name="Detail" Text="读取中…" Opacity="0.8" />
        <TextBlock x:Name="LessonLine" Text="" IsVisible="False" Opacity="0.7"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200" />
    </StackPanel>
</ci:ComponentBase>
