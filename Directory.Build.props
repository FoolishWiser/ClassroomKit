<?xml version="1.0" encoding="utf-8"?>
<!--
  ClassroomKit 唯一的版本来源。
  - Version 允许 SemVer 预发布：0.3.0-pre.1、0.3.0-pre.2 ……
  - AssemblyVersion / FileVersion 必须是三段数字（Windows 资源与 MSI 都认这个）。
  - 预发布阶段的规则见 docs/版本与发布.md：1.0.0 之前一律 -pre.N。
-->
<Project>
  <PropertyGroup>
    <Version>0.3.0-pre.2</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <Product>ClassroomKit</Product>
    <Company>ClassroomKit</Company>
    <Authors>ClassroomKit</Authors>
    <Copyright>Copyright © 2026 ClassroomKit</Copyright>
  </PropertyGroup>
</Project>
